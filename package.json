{
  "name": "@samsquare/child-ai-safety",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Child AI safety gateway research prototype; not a production safety classifier",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js", "./schema": "./dist/protocol.schema.json" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "load:synthetic": "npm run build && node scripts/load.mjs",
    "eval:synthetic": "npm run build && python3 python/evaluate.py --synthetic-demo",
    "eval:scope": "npm run build && node evaluation/scope-matrix.mjs",
    "eval:local": "npm run --silent build && node scripts/eval-local-precheck.mjs",
    "eval:delivery": "npm run --silent build && node scripts/eval-synthetic-delivery.mjs",
    "eval:rehearsal": "npm run --silent build && node scripts/eval-synthetic-delivery.mjs --rehearse",
    "demo": "npm run --silent build && node scripts/eval-synthetic-delivery.mjs --demo",
    "test:adapters": "npm run --silent build && node examples/adapter-conformance.mjs",
    "eval:report": "node scripts/report-rehearsal.mjs",
    "holdout:check": "node scripts/check-holdout.mjs",
    "holdout:plan-assessment": "node scripts/plan-holdout-assessment.mjs",
    "holdout:rehearse-claude": "npm run --silent build && node scripts/rehearse-claude-holdout.mjs",
    "holdout:score": "node scripts/score-holdout.mjs",
    "holdout:thresholds": "node scripts/check-thresholds.mjs",
    "catalog:review": "npm run build && node scripts/prepare-catalog-review.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "review:queue": "node scripts/check-readiness.mjs --queue --mode production",
    "release:check": "node scripts/check-readiness.mjs --mode production",
    "preview:check": "node scripts/check-preview.mjs",
    "eval:support-routing": "npm run --silent build && node scripts/rehearse-support-routing-v2.mjs",
    "eval:compare-support": "npm run --silent build && node scripts/eval-support-comparison.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
